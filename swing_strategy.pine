//@version=5
strategy("Institutional Swing Trading V2 (Stage 2 Pullback & VCP)", shorttitle="Swing Bot V2", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, currency=currency.USD, process_orders_on_close=false, calc_on_every_tick=false, slippage=2, max_labels_count=500, max_lines_count=500)

// ============================================================================
// 1. INPUT PARAMETERS (100% ALINIATE CU CONFIG.PY V2 — ZERO LOOK-AHEAD BIAS)
// ============================================================================
grp_risk = "1. Managementul Riscului & Capitalului"
risk_per_trade_pct = input.float(1.5, "Risc per Tranzactie (% din Capital)", minval=0.5, maxval=2.0, step=0.1, group=grp_risk)
max_single_pos_pct = input.float(33.0, "Alocare Maxima per Pozitie (%)", minval=10.0, maxval=50.0, step=1.0, group=grp_risk)
tp1_rr = input.float(1.5, "Raport R:R pentru TP1 (50% Scale-Out + Breakeven)", minval=1.0, maxval=3.0, step=0.1, group=grp_risk)
tp2_rr = input.float(2.5, "Raport R:R pentru TP2 (Runner 50%, min 1:2.0)", minval=2.0, maxval=6.0, step=0.5, group=grp_risk)
tp1_exit_pct = input.float(50.0, "Procent Inchis la TP1 (%)", minval=20.0, maxval=80.0, step=5.0, group=grp_risk)
atr_stop_mult = input.float(1.8, "Multiplicator ATR Stop-Loss", minval=1.0, maxval=3.0, step=0.1, group=grp_risk)

grp_tech = "2. Parametri Tehnici Zilnici (1D)"
ema_pullback_len = input.int(20, "Perioada EMA Trend Scurt / Trail", minval=5, maxval=50, group=grp_tech)
sma_stock_len = input.int(50, "Perioada SMA Trend Intermediar", minval=20, maxval=100, group=grp_tech)
sma_market_len = input.int(200, "Perioada SMA Trend Major", minval=100, maxval=300, group=grp_tech)
rsi4_pb_max = input.float(30.0, "RSI(4) Maxim Pullback Ordonat", minval=15.0, maxval=40.0, step=1.0, group=grp_tech)
rsi_pb_min = input.float(38.0, "RSI(14) Pullback Minim", minval=25.0, maxval=50.0, step=1.0, group=grp_tech)
rsi_pb_max = input.float(54.0, "RSI(14) Pullback Maxim", minval=45.0, maxval=65.0, step=1.0, group=grp_tech)
vol_surge_mult = input.float(1.50, "Multiplicator Volum VCP Breakout (1.50 = 150%)", minval=1.2, maxval=3.0, step=0.05, group=grp_tech)
max_atr_pct = input.float(4.3, "ATR Zilnic Maxim Admis (%)", minval=2.0, maxval=8.0, step=0.1, group=grp_tech)

grp_rs = "3. Regim Piata & Forta Relativa (RS vs SPY)"
benchmark_sym = input.symbol("SPY", "Simbol Benchmark (SPY)", group=grp_rs)
sec_bench_sym = input.symbol("QQQ", "Simbol Secundar (QQQ)", group=grp_rs)
min_rs_pullback = input.float(2.0, "Scor RS Minim Lideri (%)", minval=-5.0, maxval=20.0, step=0.5, group=grp_rs)

// ============================================================================
// 2. INDICATORI ZILNICI CAUZALI (1D)
// ============================================================================
ema20 = ta.ema(close, ema_pullback_len)
sma50 = ta.sma(close, sma_stock_len)
sma200 = ta.sma(close, sma_market_len)
rsi14 = ta.rsi(close, 14)
rsi4 = ta.rsi(close, 4)
atr14 = ta.atr(14)
atr5 = ta.atr(5)
atr_pct = (atr14 / close) * 100.0
atr_contraction = atr14 > 0 ? (atr5 / atr14) : 1.0

vol_sma20 = ta.sma(volume, 20)
vol_ratio_3d = vol_sma20 > 0 ? (ta.sma(volume, 3) / vol_sma20) : 1.0
sma50_slope = nz(((sma50 - sma50[5]) / sma50[5]) * 100.0, 0.0)
sma200_slope = nz(((sma200 - sma200[20]) / sma200[20]) * 100.0, 0.0)

prior_20_high = ta.highest(high, 20)[1]
swing_low_10 = ta.lowest(low, 10)
range_15d_pct = ((ta.highest(high, 15)[1] - ta.lowest(low, 15)[1]) / close[1]) * 100.0

// ============================================================================
// 3. FORTA RELATIVA & REGIM PIATA (SPY + QQQ)
// ============================================================================
f_weighted_roc(src) =>
    0.40 * nz(ta.roc(src, 20), 0.0) + 0.30 * nz(ta.roc(src, 60), 0.0) + 0.30 * nz(ta.roc(src, 120), 0.0)

[spy_close, spy_sma200, spy_sma50] = request.security(benchmark_sym, timeframe.period, [close, ta.sma(close, 200), ta.sma(close, 50)], lookahead=barmerge.lookahead_off)
[qqq_close, qqq_sma50] = request.security(sec_bench_sym, timeframe.period, [close, ta.sma(close, 50)], lookahead=barmerge.lookahead_off)

rs_vs_spy = f_weighted_roc(close) - f_weighted_roc(spy_close)
qqq_ok = qqq_close >= qqq_sma50 * 0.995
is_market_bullish = (spy_close > spy_sma200) and (spy_close >= spy_sma50 or qqq_ok)
is_power_trend = (spy_close >= spy_sma50) and (spy_sma50 > spy_sma200) and qqq_ok

// ============================================================================
// 4. CONFLUENTA 1W STAGE 2 (SHIFT 1 SAPTAMANA INCHISA)
// ============================================================================
[w_ema10, w_sma30, w_sma50, w_rsi14] = request.security(syminfo.tickerid, "W", [ta.ema(close, 10)[1], ta.sma(close, 30)[1], ta.sma(close, 50)[1], ta.rsi(close, 14)[1]], lookahead=barmerge.lookahead_off)
weekly_ok = na(w_sma30) or (close >= w_sma30 and w_ema10 >= w_sma30 and (na(w_sma50) or close >= w_sma50 * 0.99) and w_rsi14 >= 45.0 and w_rsi14 <= 72.0)

// ============================================================================
// 5. SETUPS VALIDATE OOS (STAGE 2 PULLBACK & VCP BREAKOUT)
// ============================================================================
stage2_ok = close > sma50 and sma50 > sma200 and ema20 > sma50 * 0.995 and sma50_slope > 0 and sma200_slope > 0 and atr_pct <= max_atr_pct and not (close < open and volume > 1.3 * vol_sma20)
rs_ok = rs_vs_spy >= min_rs_pullback and rs_vs_spy <= 45.0

is_pullback = is_market_bullish and weekly_ok and stage2_ok and rs_ok and rsi4 <= rsi4_pb_max and rsi14 >= rsi_pb_min and rsi14 <= rsi_pb_max and close >= sma50 * 1.01 and vol_ratio_3d <= 1.05
strong_close = (high > low) and (((close - low) / (high - low)) >= 0.70)
is_breakout = is_power_trend and weekly_ok and stage2_ok and rs_vs_spy >= 3.0 and close > prior_20_high and close > open and volume >= vol_surge_mult * vol_sma20 and atr_contraction <= 0.85 and range_15d_pct <= 8.0 and strong_close and ((close - ema20) / ema20) <= 0.07

// ============================================================================
// 6. EXECUTIE LA BARA URMATOARE (FARA BREAKEVEN PREMATUR INAINTE DE TP1)
// ============================================================================
var float active_entry = na
var float active_sl = na
var float active_tp1 = na
var float active_tp2 = na
var bool tp1_hit = false

in_position = strategy.position_size > 0
if not in_position
    tp1_hit := false
    active_entry := na
    active_sl := na

if not in_position and (is_pullback or is_breakout)
    setup_type = is_pullback ? "PULLBACK_EMA20" : "VOLUME_BREAKOUT"
    entry_est = is_pullback ? close * 0.997 : close
    raw_sl = is_pullback ? math.min(sma50 * 0.985, math.min(low - 0.5 * atr14, close - atr_stop_mult * atr14)) : math.min(swing_low_10, close - atr_stop_mult * atr14)
    stop_dist_pct = (entry_est - raw_sl) / entry_est

    if stop_dist_pct >= 0.022 and stop_dist_pct <= 0.075
        r_sh = entry_est - raw_sl
        dollar_risk = strategy.equity * (risk_per_trade_pct / 100.0) * (is_power_trend ? 1.0 : 0.70)
        sh = math.min(dollar_risk / r_sh, (strategy.equity * (max_single_pos_pct / 100.0)) / entry_est)
        active_entry := entry_est
        active_sl := raw_sl
        active_tp1 := entry_est + tp1_rr * r_sh
        active_tp2 := entry_est + tp2_rr * r_sh
        tp1_hit := false
        if is_pullback
            strategy.entry("LONG", strategy.long, qty=sh, limit=entry_est, comment=setup_type)
        else
            strategy.entry("LONG", strategy.long, qty=sh, comment=setup_type)
        strategy.exit("TP1 (50%)", from_entry="LONG", qty_percent=tp1_exit_pct, limit=active_tp1, stop=active_sl)
        strategy.exit("TP2 / EMA20 Trail", from_entry="LONG", limit=active_tp2, stop=active_sl)

if in_position and not na(active_entry)
    if not tp1_hit and high >= active_tp1
        tp1_hit := true
        active_sl := math.max(active_sl, active_entry * 1.002)
    if tp1_hit
        trail_ema = ema20 * 0.985
        if trail_ema > active_sl and trail_ema < close * 0.995
            active_sl := trail_ema
    strategy.exit("TP1 (50%)", from_entry="LONG", qty_percent=tp1_exit_pct, limit=active_tp1, stop=active_sl)
    strategy.exit("TP2 / EMA20 Trail", from_entry="LONG", limit=active_tp2, stop=active_sl)

plot(ema20, "EMA 20", color=color.aqua, linewidth=2)
plot(sma50, "SMA 50", color=color.orange, linewidth=2)
plot(sma200, "SMA 200", color=color.red, linewidth=2)
plot(in_position ? active_sl : na, "Stop-Loss Activ", color=color.red, style=plot.style_linebr, linewidth=2)
plot(in_position and not tp1_hit ? active_tp1 : na, "TP1 (1.5R)", color=color.lime, style=plot.style_linebr, linewidth=1)
plot(in_position ? active_tp2 : na, "TP2 (2.5R)", color=color.green, style=plot.style_linebr, linewidth=2)
